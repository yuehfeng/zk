<zk xmlns:w="client">
	<label multiline="true">
		A page that is queued while another one is still rendering is fetched from a promise
		continuation, which runs even after the viewer has been detached. The a11y page label must
		not demand the -content node there.
		1. The first viewer detaches itself as soon as its first page is rendered. No error box
		   shows up.
		2. The second viewer keeps working and its canvas carries aria-label="#1".
	</label>

	<div id="holder">
		<pdfviewer id="pv" height="300px" src="/test2/B96-ZK-5426.pdf">
			<attribute w:name="_handleAfterPageRendering">
				function (pdfFirstRender) {
					if (!window.zk5725Detached &amp;&amp; this._pdf) {
						// page 2 was queued while page 1 was still rendering, and the container
						// closed in the same tick
						window.zk5725Detached = true;
						this._shouldZoomFit = '';
						this._pendingPageNum = 2;
						this.detach();
						this.$_handleAfterPageRendering(false);
						return;
					}
					this.$_handleAfterPageRendering(pdfFirstRender);
				}
			</attribute>
		</pdfviewer>
	</div>

	<pdfviewer id="pvOk" height="300px" src="/test2/B96-ZK-5426.pdf"/>
</zk>
