<zk xmlns="http://www.zkoss.org/2005/zul">
	<vlayout spacing="10px" style="padding:16px;">
		<label value="Each checkbox must expose exactly one label element to its
			form field. Scan with aXe rule form-field-multiple-labels."/>
		<hlayout spacing="8px">
			<label value="default:"/>
			<checkbox id="cbDefault" label="Receive notifications"/>
		</hlayout>
		<hlayout spacing="8px">
			<label value="tristate:"/>
			<checkbox id="cbTristate" mold="tristate" label="Receive notifications"/>
		</hlayout>
		<hlayout spacing="8px">
			<label value="switch:"/>
			<checkbox id="cbSwitch" mold="switch" label="Receive notifications"/>
		</hlayout>
		<hlayout spacing="8px">
			<label value="toggle:"/>
			<checkbox id="cbToggle" mold="toggle" label="Receive notifications"/>
		</hlayout>
	</vlayout>
</zk>
