<zk>
	<label multiline="true">
		Opening a groupbox that was closed at load time rebinds its children. A render-deferred child
		only has a placeholder at that moment, so it must be left alone (ZK-5681) - on a tablet too.
		1. Click "open". There should be no error in the console (F12).
		2. The label inside the groupbox shows up, the checkbox stays deferred.
	</label>

	<groupbox id="gb" open="false" width="300px">
		<caption label="a closed groupbox"/>
		<label id="inside" value="content of the groupbox"/>
		<!-- renderdefer leaves this checkbox as a bare placeholder while the groupbox is redrawn -->
		<checkbox id="cbx" label="deferred" renderdefer="600000"/>
	</groupbox>

	<button id="op" label="open" onClick="gb.setOpen(true)"/>
</zk>
