<zk>
	<label multiline="true">
		A drawer inside a renderdefer container is bound but has no DOM yet, so opening it from the
		server must not demand the -real node - and once the DOM finally shows up the drawer still
		owes the rest of the open lifecycle.
		1. Click "open the deferred drawer". Nothing shows up and there is no error box.
		2. Click "render the deferred drawer". It slides in from the right, on top of the page,
		   and the keyboard is trapped inside it (Tab cycles within the drawer).
		3. Click "open the rendered drawer". The drawer slides in from the left.
	</label>

	<div id="wrap" renderdefer="600000">
		<drawer id="deferred" title="deferred" position="right">
			<label value="deferred content"/>
			<button id="inDeferred" label="inside the deferred drawer"/>
		</drawer>
	</div>
	<button id="openDeferred" label="open the deferred drawer" onClick="deferred.open()"/>
	<button id="renderDeferred" label="render the deferred drawer"
			onClick='Clients.evalJavaScript("zk.Widget.$(&apos;$wrap&apos;).forcerender();")'/>

	<drawer id="rendered" title="rendered" position="left">
		<label value="rendered content"/>
	</drawer>
	<button id="openRendered" label="open the rendered drawer" onClick="rendered.open()"/>
</zk>
