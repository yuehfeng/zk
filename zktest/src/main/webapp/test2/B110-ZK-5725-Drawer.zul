<?script content="window.zk5725Errors=[];window.addEventListener('error',function(evt){if(evt.message)window.zk5725Errors.push(evt.message);});window.zk5725Shown=[];(function hook(){if(typeof zUtl==='undefined'||!zUtl.fireShown){setTimeout(hook,10);return;}if(zUtl.fireShown.zk5725)return;var orig=zUtl.fireShown;var patched=function(wgt){if(wgt&amp;&amp;wgt.id)window.zk5725Shown.push(wgt.id);return orig.apply(this,arguments);};patched.zk5725=true;zUtl.fireShown=patched;})();"?>
